# Supabase — stores every diagnostic request.
# Project Settings > API. The service role key is server-only; never expose it client-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails a copy of each request.
RESEND_API_KEY=
# Where the notification lands. Until a domain is verified in Resend, this must
# be the email address on the Resend account.
INTAKE_NOTIFY_EMAIL=
# Optional. Defaults to Resend's shared onboarding@resend.dev sender, which can
# only deliver to the account owner. Switch to a verified stateofashes.com
# address once the domain is set up in Resend.
INTAKE_FROM_EMAIL=

# Publish emails/diagnostic-received.html in Resend, then enable visitor replies.
# Sender: State of Ashes <info@stateofashes.com>; domain must be verified.
INTAKE_AUTOREPLY_TEMPLATE_ID=
